# Copy to .env and fill in real values
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./frpews.db

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Optional: NiMet official API key (https://nimet.gov.ng / api.nimet.gov.ng)
# Without this key the system uses Open-Meteo public feeds (recommended for demo)
NIMET_API_KEY=

# Admin seed user
ADMIN_EMAIL=admin@frpews.local
ADMIN_PASSWORD=Admin123!
